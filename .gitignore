# Everything this project reads or writes that is not committed lives here: the ROM you supply,
# the toolchain you supply, every build output, cache, environment, queue, lock and scratch tree.
/artifacts/

# Python
__pycache__/
*.py[cod]

# Editors and operating systems
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Agent worktrees and local session state.
.claude/

# Splat writes these from the split and [split].symbols; they are products, not inputs.
# The linker script the split writes: a build product, regenerated by every extraction.
versions/*/*.ld
versions/*/undefined_funcs_auto.txt
versions/*/undefined_syms_auto.txt

# Credentials. Never committed. Stated here rather than left to a machine's global excludes,
# which a clone does not carry.
.env
.env.*
*.env
*.pem
*.key
